   "showLabel": false,
   "labelPos": "b",
   "params": {
    "text": "**Mach–Zehnder interferometer** — one layout, three ways to put phase into an arm. Each row splits the beam, changes one path, and recombines: whatever leaves one port arrives at the other.",
    "fontSize": 14,
    "fill": "#333333"
   }
  },
  {
   "id": "alab",
   "type": "textlabel",
   "x": 100,
