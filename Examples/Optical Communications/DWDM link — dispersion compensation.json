    {
      "id": "title",
      "type": "textlabel",
      "x": 60,
      "y": -215,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "**Four-channel DWDM link — chromatic dispersion and its compensation**",
        "fontSize": 22,
        "fill": "#333333"
      }
    },
    {
      "id": "subtitle",
      "type": "textlabel",
      "x": 60,
      "y": -180,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "ITU-T G.694.1 grid, 200 GHz spacing · 40 GHz trains of 8.3 ps Gaussian pulses (the clock of a 40 Gb/s RZ-33% signal) · 10 km of standard single-mode fiber, then dispersion-compensating fiber.",
        "fontSize": 12,
        "fill": "#66717d"
      }
    },
    {
      "id": "caveat",
      "type": "textlabel",
      "x": 60,
      "y": -155,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "Traced: filter routing, spectral slicing, fiber loss and GDD on Gaussian pulses. Not modelled: data patterns/BER, noise, nonlinearity, PMD, dispersion slope (one β₂ for all channels), filter roll-off.",
        "fontSize": 11,
        "fill": "#66717d"
      }
    },
    {
      "id": "txnote",
      "type": "textlabel",
      "x": 60,
      "y": 420,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "**MUX** · thin-film band-pass filters: each passes",
        "fontSize": 11,
        "fill": "#44505c"
      }
    },
    {
      "id": "txnote2",
      "type": "textlabel",
      "x": 60,
      "y": 437,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "one channel and reflects the rest onto the common path.",
        "fontSize": 11,
        "fill": "#44505c"
      }
    },
    {
      "id": "smfnote",
      "type": "textlabel",
      "x": 500,
      "y": 410,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "**SMF** · 10 km · D = 17 ps/(nm·km), β₂ = −21.7 ps²/km · 0.275 dB/km (G.652 typical)",
        "fontSize": 11,
        "fill": "#44505c"
      }
    },
    {
      "id": "dcfnote",
      "type": "textlabel",
      "x": 500,
      "y": 432,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "**DCF** · 1.7 km · D = −100 ps/(nm·km), β₂ = +127.6 ps²/km · 0.5 dB/km (assumed)",
        "fontSize": 11,
        "fill": "#44505c"
      }
    },
    {
      "id": "rxnote",
      "type": "textlabel",
      "x": 500,
      "y": 520,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "**DEMUX** · the same filters in reverse drop one channel per port.",
        "fontSize": 11,
        "fill": "#44505c"
      }
    },
    {
      "id": "budget",
      "type": "textlabel",
      "x": 500,
      "y": 545,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "Per channel: 0 dBm − 2.75 dB (SMF) − 0.85 dB (DCF) = −3.6 dBm ≈ 0.44 mW.",
        "fontSize": 11,
        "fill": "#44505c"
      }
    },
    {
      "id": "try",
      "type": "textlabel",
      "x": 60,
      "y": 790,
      "rot": 0,
      "label": "",
      "showLabel": false,
      "params": {
        "text": "**Try:** set the DCF β₂ to 0 → pulses spread to 73 ps, three times the 25 ps bit slot · set the DCF length to 1.2 km → 23 ps, partial compensation · tune TX2 by +0.8 nm → its filter passes only a sliver · delete a laser → its port goes dark.",
        "fontSize": 11,
        "fill": "#44505c"
      }
    }
