  {
   "id": "title",
   "type": "textlabel",
   "x": -175,
   "y": -125,
   "rot": 0,
   "label": "",
   "showLabel": false,
   "params": {
    "text": "**I/Q optical modulator — nested Mach–Zehnder**",
    "fontSize": 24,
    "fill": "#333333"
   }
  },
  {
   "id": "note-i",
   "type": "textlabel",
   "x": 150,
   "y": -75,
   "rot": 0,
   "label": "",
   "showLabel": false,
   "params": {
    "text": "**I modulator.** Push-pull: +φ/2 in one arm, −φ/2 in the other.\nIts output field is sin(φ/2): real, from −1 to +1.",
    "fontSize": 14,
    "fill": "#333333"
   }
  },
  {
   "id": "note-q",
   "type": "textlabel",
   "x": -175,
   "y": 475,
   "rot": 0,
   "label": "",
   "showLabel": false,
   "params": {
    "text": "**Q modulator.** The same again, then a fixed 90° shift:\nits field adds in quadrature, as i·Q.",
    "fontSize": 14,
    "fill": "#333333"
   }
  },
  {
   "id": "note-out",
   "type": "textlabel",
   "x": 425,
   "y": 425,
   "rot": 0,
   "label": "",
   "showLabel": false,
   "params": {
    "text": "**Output field ∝ I + iQ.** At 90° the power is I² + Q²:\nflipping a sign changes the phase of the light, not this reading.\nSet the 90° shifter to 0° and the two ports start trading power instead.",
    "fontSize": 14,
    "fill": "#333333"
   }
  },
